KNOWLEDGE_PILOT_ADDR=127.0.0.1:8080
KNOWLEDGE_PILOT_DB_PATH=./data/knowledge-pilot.db
# KNOWLEDGE_PILOT_API_TOKEN=
KNOWLEDGE_PILOT_REQUEST_BODY_LIMIT_BYTES=2097152
KNOWLEDGE_PILOT_CHUNK_SIZE=600
KNOWLEDGE_PILOT_CHUNK_OVERLAP=100
KNOWLEDGE_PILOT_EMBEDDING_PROVIDER=ollama
KNOWLEDGE_PILOT_EMBEDDING_BASE_URL=http://127.0.0.1:11434
KNOWLEDGE_PILOT_EMBEDDING_PATH=/api/embed
# Supported embedding models (via Ollama):
#   qwen3-embedding:0.6b, bge-m3, nomic-embed-text, mxbai-embed-large,
#   snowflake-arctic-embed, all-minilm, e5, gte, jina-embeddings
KNOWLEDGE_PILOT_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Set only when KNOWLEDGE_PILOT_EMBEDDING_MODEL is a verified custom embedding model
# whose name does not follow common embedding model naming.
# KNOWLEDGE_PILOT_EMBEDDING_ALLOW_UNVERIFIED_MODEL=true
KNOWLEDGE_PILOT_RAG_MODE=auto
# No configured chat model: RAG and bot queries return 503 model_not_configured.
# Use extractive only when explicitly running offline RAG tests/evals; bot chat still requires an LLM.
KNOWLEDGE_PILOT_LLM_PROVIDER=none
# For LLM-powered answers via Ollama (recommended for production):
# 1. ollama pull qwen2.5:1.5b
# 2. Set KNOWLEDGE_PILOT_LLM_PROVIDER=custom
# 3. Configure the service address and model below (there is no default chat model):
# KNOWLEDGE_PILOT_LLM_PROVIDER=custom
# KNOWLEDGE_PILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# KNOWLEDGE_PILOT_LLM_CHAT_COMPLETIONS_PATH=/chat/completions
# KNOWLEDGE_PILOT_LLM_MODEL=qwen2.5:1.5b
# KNOWLEDGE_PILOT_LLM_API_KEY=
# KNOWLEDGE_PILOT_LLM_AUTH_HEADER=Authorization
# KNOWLEDGE_PILOT_LLM_AUTH_SCHEME=Bearer
# KNOWLEDGE_PILOT_LLM_HEADERS_JSON={"X-Custom":"value"}
# Legacy OpenAI-compatible names are still supported:
# KNOWLEDGE_PILOT_OPENAI_BASE_URL=https://api.openai.com/v1
# KNOWLEDGE_PILOT_OPENAI_MODEL=gpt-4.1-mini
# KNOWLEDGE_PILOT_OPENAI_API_KEY=
# Claude / Anthropic Messages API:
# KNOWLEDGE_PILOT_LLM_PROVIDER=claude
# KNOWLEDGE_PILOT_CLAUDE_BASE_URL=https://api.anthropic.com/v1
# KNOWLEDGE_PILOT_CLAUDE_MESSAGES_PATH=/messages
# KNOWLEDGE_PILOT_CLAUDE_MODEL=claude-sonnet-4-20250514
# KNOWLEDGE_PILOT_CLAUDE_ANTHROPIC_VERSION=2023-06-01
# KNOWLEDGE_PILOT_CLAUDE_MAX_TOKENS=1024
# KNOWLEDGE_PILOT_CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
KNOWLEDGE_PILOT_UI_ENABLED=true
RUST_LOG=info

# Rate limiting: maximum requests per minute per client IP
KNOWLEDGE_PILOT_RATE_LIMIT_RPM=300

# SQL Skills & Enterprise Platform Bot configuration:
# Path to JSON file defining predefined SQL skills (defaults to ./config/skills.json or ./skills.json)
# KNOWLEDGE_PILOT_SKILLS_PATH=./config/skills.json
# Database connection strings corresponding to connection_ref in skills (e.g. PRIMARY, ANALYTICS)
# Format: mysql://user:password@host:port/database or sqlite://path/to/file.db
# KP_DB_PRIMARY=mysql://root:password@127.0.0.1:3306/platform_db
# KP_DB_ANALYTICS=mysql://root:password@127.0.0.1:3306/analytics_db
# KP_DB_LOCAL=sqlite://./data/business.db
