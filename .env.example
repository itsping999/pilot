AGENT_ADDR=127.0.0.1:8080
AGENT_DATA_DIR=./data/agent
# Required for protected APIs. Keep this service token in the portal backend.
AGENT_API_TOKEN=
AGENT_SKILLS_DIR=./skills
AGENT_MCP_CONFIG_PATH=./config/mcp.json
# Optional web search/read: use ./config/mcp.web-search.example.json, or merge
# its exa entry into your private MCP configuration. Send SIGHUP after changing
# Skill/MCP files. Environment changes need restart.

# No model is selected implicitly.
AGENT_LLM_PROVIDER=none
AGENT_LLM_MODEL=
# For an explicitly configured local OpenAI-compatible endpoint:
# AGENT_LLM_PROVIDER=custom
# AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_LLM_MODEL=your-installed-chat-model
# AGENT_LLM_API_KEY=
# For Anthropic-compatible models:
# AGENT_LLM_PROVIDER=anthropic
# AGENT_LLM_BASE_URL=https://api.anthropic.com
# AGENT_LLM_MODEL=your-chat-model
# AGENT_LLM_API_KEY=
AGENT_LLM_CONTEXT_WINDOW=32768
AGENT_LLM_MAX_TOKENS=4096

AGENT_REQUEST_BODY_LIMIT_BYTES=2097152
AGENT_MAX_MESSAGE_CHARS=20000
AGENT_RUN_TIMEOUT_MS=120000
AGENT_MAX_TURNS=10
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_ACTIVE_SESSIONS=50
AGENT_IDLE_TIMEOUT_MS=900000
# AGENT_SYSTEM_PROMPT=

# Docker Compose host configuration mount:
# AGENT_MCP_CONFIG_FILE=./config/mcp.json
# Administrator MCP credential references can be defined here:
# BUSINESS_MCP_TOKEN=
# RAG_API_TOKEN=  # Reference it in the RAG MCP Authorization header.
# EXA_API_KEY=  # Optional; reference it in an MCP x-api-key header for higher limits.
