[Unit]
Description=KnowledgePilot embedded RAG service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=knowledge-pilot
Group=knowledge-pilot
WorkingDirectory=/var/lib/knowledge-pilot
Environment=KNOWLEDGE_PILOT_ADDR=127.0.0.1:8080
Environment=KNOWLEDGE_PILOT_DB_PATH=/var/lib/knowledge-pilot/data/knowledge-pilot.db
Environment=KNOWLEDGE_PILOT_REQUEST_BODY_LIMIT_BYTES=2097152
Environment=KNOWLEDGE_PILOT_CHUNK_SIZE=800
Environment=KNOWLEDGE_PILOT_CHUNK_OVERLAP=120
Environment=KNOWLEDGE_PILOT_EMBEDDING_PROVIDER=ollama
Environment=KNOWLEDGE_PILOT_EMBEDDING_BASE_URL=http://127.0.0.1:11434
Environment=KNOWLEDGE_PILOT_EMBEDDING_PATH=/api/embed
Environment=KNOWLEDGE_PILOT_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Configure the LLM provider, model, and endpoint/API key in a service override.
Environment=KNOWLEDGE_PILOT_LLM_PROVIDER=none
Environment=KNOWLEDGE_PILOT_UI_ENABLED=true
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/knowledge-pilot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/knowledge-pilot

[Install]
WantedBy=multi-user.target
